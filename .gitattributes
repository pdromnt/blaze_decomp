* text=auto
*.c text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.ini binary
*.dat binary
*.DAR -text
*.dar -text
*.mid -text
*.MID -text
*.wav -text
*.bin -text
*.ico -text
*.icns -text
*.gif -text
# Preserve original documentation bytes/encoding instead of normalizing them.
/html/** binary
/html_en/** binary
.gitattributes text eol=lf
.gitignore text eol=lf
# Preserve upstream license bytes, including its original whitespace.
/source/third_party/SDL3-LICENSE.txt -text -whitespace
/source/third_party/FluidSynth-LICENSE.txt -text -whitespace
/source/third_party/GeneralUser-GS-LICENSE.txt -text -whitespace
/source/third_party/GCEM-LICENSE.txt -text -whitespace
